{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  "include": [
    "extension/src/**/*.ts",
    "extension/popup/**/*.ts",
    "tests/**/*.ts"
  ]
}
